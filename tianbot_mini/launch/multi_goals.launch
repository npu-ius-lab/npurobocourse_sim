<launch>
    <!-- For Simulation -->
    <arg name="sim_mode" default="false" />
    <param name="/use_sim_time" value="$(arg sim_mode)"/>
    
    <!-- multi goals node -->
    <node pkg="tianbot_mini" type="multi_goals.py" respawn="false" name="multi_goals" output="screen">
        <!-- Goal positions (X coordinates) -->
        <param name="goalListX" value="[0.33, -0.25, -2.41, -3.13]" />
        <!-- Goal positions (Y coordinates) -->
        <param name="goalListY" value="[0.72, -0.36, -0.08, 1.0]" />

        <!-- Goal orientations (Quaternion X) -->
        <param name="QuaternionListX" value="[0, 0, 0, 0]" />
        <!-- Goal orientations (Quaternion Y) -->
        <param name="QuaternionListY" value="[0, 0, 0, 0]" />
        <!-- Goal orientations (Quaternion Z) -->
        <param name="QuaternionListZ" value="[0, 0, 0, 0]" />
        <!-- Goal orientations (Quaternion W) -->
        <param name="QuaternionListW" value="[1, 1, 1, 1]" />
        
        <!-- Map frame ID -->
        <param name="map_frame" value="tianbot_mini/map" />
        
        <!-- Retry count (0 means infinite loop) -->
        <param name="retry" value="0" />
    </node>
    
</launch>
