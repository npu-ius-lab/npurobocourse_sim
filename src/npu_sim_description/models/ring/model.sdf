<?xml version="1.0"?>
<!--
  Vertical course ring: the drone traverses the opening along the world
  Y axis. Ring circle radius 0.49 m with 0.07 m tube, giving the 0.42 m
  inner / 0.56 m outer radii from the course layout. Ring center is 1.0 m
  above the model origin, matching the takeoff/mission pass height.
  Built from box segments because Gazebo Harmonic cannot render a
  torus visual and DART has no torus collision primitive.
-->
